# Python bytecode and test/tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments and local package metadata
.venv/
venv/
env/
*.egg-info/

# Jupyter, IPython, and Matplotlib runtime/cache files
.ipynb_checkpoints/
.jupyter/
.ipython/
.matplotlib/
jupyter-runtime/

# Local configuration and secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Editors and operating systems
.DS_Store
Thumbs.db
Desktop.ini
*.code-workspace

# Do not ignore .vscode/settings.json: it selects the project virtual environment.
